{
  "$schema": "./addons-catalog.schema.json",
  "addons": [
    {
      "id": "portal-template",
      "displayName": "Portal Template",
      "description": "An example portal showcasing the Portainer add-on integration.",
      "shortDescription": "Example Portainer add-on portal",
      "helmChartRepository": "oci://ghcr.io/portainer/dev-charts/portal-template",
      "icon": "data:image/png;base64,",
      "path": "/addons/portal-template",
      "serviceUrl": "http://portal-template.portainer-addon-portal-template.svc.cluster.local",
      "healthCheckPath": "/readyz"
    },
    {
      "id": "portainer-run",
      "displayName": "Portainer-Run",
      "description": "A governed, self-service deployment portal for Kubernetes, backed by Portainer Business Edition. Portainer-Run sits between the people who build applications with AI coding tools and the Kubernetes infrastructure those applications need to run on.",
      "shortDescription": "Drag'n'drop deployment for Apps",
      "helmChartRepository": "oci://ghcr.io/portainer/dev-charts/portainer-run",
      "icon": "data:image/svg+xml;base64,",
      "path": "/addons/portainer-run",
      "serviceUrl": "http://portainer-run.portainer-addon-portainer-run.svc.cluster.local",
      "healthCheckPath": "/healthz"
    },
    {
      "id": "portainer-idp",
      "displayName": "Portainer-IDP (Beta)",
      "description": "A self-service developer portal for Kubernetes, backed by Portainer Business Edition. Portainer IDP gives application teams a governed path from a Git repository to a running workload - deploy targets, a manifest builder, secrets and per-user Git identities - without handing them direct cluster or edge access.",
      "shortDescription": "Self-service developer portal",
      "helmChartRepository": "oci://ghcr.io/portainer/dev-charts/portainer-idp",
      "icon": "data:image/svg+xml;base64,",
      "path": "/addons/portainer-idp",
      "serviceUrl": "http://portainer-idp.portainer-addon-portainer-idp.svc.cluster.local",
      "healthCheckPath": "/readyz"
    },
    {
      "id": "portainer-command",
      "displayName": "Portainer-Command (Beta)",
      "description": "A governed platform for AI agents to do work on Kubernetes environments: read-only investigation, changes proposed as pull requests, humans approving, and per-user AI Workspaces running OpenCode in-cluster.",
      "shortDescription": "Governed AI agents for K8s",
      "helmChartRepository": "oci://ghcr.io/portainer/dev-charts/portainer-command",
      "icon": "data:image/svg+xml;base64,",
      "path": "/addons/portainer-command",
      "serviceUrl": "http://portainer-command.portainer-addon-portainer-command.svc.cluster.local",
      "healthCheckPath": "/readyz"
    },
    {
      "id": "portainer-migrate",
      "displayName": "Portainer-Migrate (Beta)",
      "description": "Migrate existing Docker and Swarm workloads to Kubernetes. Portainer Migrate discovers your containers, Compose stacks, and Swarm services, translates them into Kubernetes manifests, commits them to a git repository, and deploys them as Portainer GitOps stacks — one organized folder per environment.",
      "shortDescription": "Docker/Swarm to Kubernetes migration",
      "helmChartRepository": "oci://ghcr.io/portainer/dev-charts/portainer-migrate",
      "icon": "data:image/svg+xml;base64,",
      "path": "/addons/portainer-migrate",
      "serviceUrl": "http://portainer-migrate.portainer-addon-portainer-migrate.svc.cluster.local",
      "healthCheckPath": "/readyz"
    }
  ]
